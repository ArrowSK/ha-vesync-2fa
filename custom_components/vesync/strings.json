  "exceptions": {
    "api_response_error": {"message": "Invalid response from the VeSync API"},
    "invalid_auth": {"message": "[%key:common::config_flow::error::invalid_auth%]"},
    "server_error": {"message": "Server error occurred while connecting to VeSync"}
